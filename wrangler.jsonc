{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thomasmeiss-video",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-29",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "keep_vars": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    {
      "name": "EMAIL",
      // No allowed_destination_addresses: the binding is unrestricted and
      // Cloudflare's own check is the gate — CONTACT_TO must be a VERIFIED
      // DESTINATION ADDRESS (Email Routing → Destination Addresses), not a
      // routing rule. contact@thomasmeiss.video is only a Route that forwards
      // to the verified inbox, which is why sending to it failed with
      // "destination address is not a verified address".
      //
      // If thomasmeiss.video is ever onboarded as a sending domain, that check
      // disappears and any recipient becomes reachable — add an explicit
      // allow-list here at that point.
      // Set remote: true after wrangler login to send real emails in dev
    }
  ],
  // "vars": {
  //   "CONTACT_FROM": "hello@thomasmeiss.video",
  //   "CONTACT_FROM_NAME": "Thomas Meiss Video",
  //   "CONTACT_TO": "CONTACT_TO@example.com"
  // },
    "observability": {
      "enabled": false,
      "head_sampling_rate": 1,
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
        "persist": true,
        "invocation_logs": true
      },
      "traces": {
        "enabled": true,
        "persist": true,
        "head_sampling_rate": 1
      }
    }
}
