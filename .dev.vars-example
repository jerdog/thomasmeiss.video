# Worker runtime vars — available as `env.*` in worker/index.ts during local dev.
CONTACT_FROM=hello@thomasmeiss.video
CONTACT_FROM_NAME=Thomas Meiss Video
CONTACT_TO=contact@thomasmeiss.video

# Deploy credentials — used only by scripts/deploy.sh, never uploaded to the
# Worker. Pins the target account so deploys don't follow `wrangler login`
# state on a machine with multiple Cloudflare accounts.
# Token needs Workers Scripts:Edit (plus Workers R2/KV etc. if bindings grow).
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token